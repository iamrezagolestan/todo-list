{
  "transforms": [
    {
      "mode": "sql",
      "include": "**/*.sql",
      "emitTemplate": "./generatedTypes/queries/{{name}}.queries.ts"
    }
  ],
  "srcDir": "./db/queries",
  "failOnError": true,
  "camelCaseColumnNames": false,
  "db": {
    "host": "localhost",
    "port": 5432,
    "user": "postgres",
    "dbName": "task_db"
  }
}
