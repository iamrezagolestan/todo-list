{
  "name": "todo-list",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:new": "dbmate --migrations-dir db/migrations new",
    "db:up": "dotenv -e .env -- dbmate --migrations-dir db/migrations up",
    "db:down": "dotenv -e .env -- dbmate --migrations-dir db/migrations down",
    "db:status": "dotenv -e .env -- dbmate --migrations-dir db/migrations status",
    "db:generate": "dotenv -e .env -- pgtyped -c pgtyped.config.json",
    "db:seed:bulk": "dotenv -e .env -- bun run db/seeds/run-bulk-properties.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.4",
    "next-intl": "^4.14.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "dbmate": "^2.35.1"
  }
}
